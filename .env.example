# Base de datos Postgres (Neon desde el Marketplace de Vercel la crea sola y carga estas variables)
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host/db?sslmode=require"

# Clave secreta para firmar las sesiones (OBLIGATORIA en producción, mínimo 16 caracteres).
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Etiquetas EAN-13 de la balanza (solo si algún día se imprimen etiquetas)
# "CANTIDAD" = el valor es el peso | "TOTAL" = el valor es el importe
NEXT_PUBLIC_EAN_MODE="CANTIDAD"
NEXT_PUBLIC_EAN_DECIMALS="3"

# ---------- Cobro con QR (Mercado Pago, API de Orders) ----------
# Cobro con QR Mercado Pago (en preparación)
# "false" (por defecto) = no aparece en la Caja ni en Configuración y sus APIs responden 404
FEATURE_MP_QR="false"
# "mock" = MODO DEMO (no se cobra nada, aparece el botón "Simular pago (demo)")
# "mercadopago" = cobros reales: cada comercio conecta SU cuenta (OAuth) en Configuración → Pagos.
PAYMENT_PROVIDER="mock"
# Solo demo: segundos tras los cuales el pago se aprueba solo (0 = desactivado)
MOCK_AUTO_APPROVE_SECONDS="0"

# App de Mercado Pago (Tus integraciones → tu aplicación → Credenciales). ¡El client secret es SECRETO!
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# URL de vuelta del OAuth. Tiene que estar cargada IGUAL en la app de Mercado Pago (Redirect URL):
MP_REDIRECT_URI="https://<tu-dominio>/api/mercadopago/callback"
# Clave para cifrar los tokens de cada comercio en la base (AES-256-GCM): 32 bytes en hex. ¡SECRETO!
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambiás, los tokens guardados no se pueden leer: cada comercio tiene que volver a conectar.
MP_TOKEN_ENCRYPTION_KEY=""
# Clave secreta de Webhooks (Tus integraciones → Webhooks), para validar las notificaciones
MP_WEBHOOK_SECRET=""

# Clave de los cron jobs de Vercel (vercel.json): Vercel la manda como "Authorization: Bearer <CRON_SECRET>".
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
