# Base de datos Postgres (Neon desde el Marketplace de Vercel la crea sola y carga estas variables)
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host/db?sslmode=require"

# Clave secreta para firmar las sesiones (OBLIGATORIA en producción, mínimo 16 caracteres).
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Etiquetas EAN-13 de la balanza (solo si algún día se imprimen etiquetas)
# "CANTIDAD" = el valor es el peso | "TOTAL" = el valor es el importe
NEXT_PUBLIC_EAN_MODE="CANTIDAD"
NEXT_PUBLIC_EAN_DECIMALS="3"

# ---------- Cobro con QR (Mercado Pago, API de Orders) ----------
# "mock" = MODO DEMO (no se cobra nada, aparece el botón "Simular pago (demo)")
# "mercadopago" = cobros reales. Para pasar a producción solo hay que cambiar esto y completar las 3 de abajo.
PAYMENT_PROVIDER="mock"
# Solo demo: segundos tras los cuales el pago se aprueba solo (0 = desactivado)
MOCK_AUTO_APPROVE_SECONDS="0"

# Access token de PRODUCCIÓN de tu aplicación en Mercado Pago (Tus integraciones → Credenciales). ¡SECRETO!
MP_ACCESS_TOKEN=""
# external_id de la caja (POS) creada en Mercado Pago para este punto de venta
MP_EXTERNAL_POS_ID=""
# Clave secreta de Webhooks (Tus integraciones → Webhooks), para validar las notificaciones
MP_WEBHOOK_SECRET=""
