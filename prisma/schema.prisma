generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN // Dueño: todo
  CASHIER // Cajero: caja y ventas del día
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  name         String
  passwordHash String
  role         Role       @default(CASHIER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sales        Sale[]
  auditLogs    AuditLog[]
  /// Comercio al que pertenece (hoy hay uno solo; null = se asigna el comercio por defecto)
  merchantId   Int?
  merchant     Merchant?  @relation(fields: [merchantId], references: [id], onDelete: SetNull)
}

/// El comercio (verdulería, almacén…). Nombre y dirección se usan para crear la sucursal en Mercado Pago.
model Merchant {
  id            Int                 @id @default(autoincrement())
  name          String
  streetName    String?             @map("street_name")
  streetNumber  String?             @map("street_number")
  city          String?
  state         String?
  latitude      Decimal?            @db.Decimal(9, 6)
  longitude     Decimal?            @db.Decimal(9, 6)
  reference     String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  users         User[]
  mpAccount     MercadoPagoAccount?
  paymentOrders PaymentOrder[]
  devices       Device[]
  deviceSales   DeviceSale[]

  @@map("merchants")
}

/// Cuenta de Mercado Pago conectada por OAuth (una por comercio).
/// Los tokens se guardan cifrados (AES-256-GCM con MP_TOKEN_ENCRYPTION_KEY), nunca en claro.
/// `status`: "connected" | "revoked".
model MercadoPagoAccount {
  id              String   @id @default(cuid())
  merchantId      Int      @unique @map("merchant_id")
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mpUserId        String   @unique @map("mp_user_id")
  mpNickname      String?  @map("mp_nickname")
  accessToken     String   @map("access_token")
  refreshToken    String   @map("refresh_token")
  expiresAt       DateTime @map("expires_at")
  storeId         String?  @map("store_id")
  externalStoreId String?  @map("external_store_id")
  posId           String?  @map("pos_id")
  externalPosId   String?  @map("external_pos_id")
  status          String   @default("connected")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("mercadopago_accounts")
}

/// Registro de acciones sensibles: logins, cambios de precio, anulaciones, usuarios…
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  action    String
  entity    String
  entityId  String?
  details   Json?

  @@index([createdAt])
  @@index([action])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

/// Cómo se vende el producto: por kilo (con balanza) o por unidad (atado, lechuga, maple…)
enum SaleUnit {
  KG
  UNIT
}

enum PaymentMethod {
  CASH // Efectivo
  DEBIT // Débito
  CREDIT // Crédito
  TRANSFER // Transferencia
  MERCADOPAGO // Mercado Pago / QR
  OTHER // Otro
}

/// Catálogo de productos. `code` es el PLU (el mismo número que tiene cargado la balanza).
/// `price` es el precio por kilo si unit = KG, o por unidad si unit = UNIT.
model Product {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  name       String
  unit       SaleUnit   @default(KG)
  price      Decimal    @db.Decimal(12, 2)
  /// "Cantidad ingresada" (opcional): kilos si se vende por kilo, unidades si es por unidad.
  quantityIn Decimal?   @db.Decimal(12, 3)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  saleItems  SaleItem[]
}

/// Una venta = un carrito validado. El medio de pago es opcional.
model Sale {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  total         Decimal        @db.Decimal(12, 2)
  status        SaleStatus     @default(COMPLETED)
  paymentMethod PaymentMethod?
  userId        Int?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  paymentOrder  PaymentOrder?
  /// Si la venta vino de un equipo Libretita conectado a la balanza
  deviceSale    DeviceSale?

  @@index([createdAt])
}

/// Línea del carrito. Se guarda una "foto" del nombre, unidad y precio al momento de la venta,
/// así si después cambiás el precio del producto, el histórico no se altera.
/// `quantity` = kilos (unit KG) o unidades (unit UNIT).
/// `productId` null = "Producto no registrado" (monto libre cargado en modo Precio de la caja).
model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCode String
  productName String
  unit        SaleUnit
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Decimal  @db.Decimal(10, 3)
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

/// Cobro con QR (Mercado Pago, API de Orders). La venta (`Sale`) se crea recién cuando el pago
/// queda aprobado ("processed"); hasta entonces el ticket se guarda como foto en `items`.
/// `provider`: "mock" (modo demo) | "mercadopago".
/// `status`: "created" | "processed" | "expired" | "canceled" | "refunded" (mismos valores que MP).
model PaymentOrder {
  id          String    @id @default(cuid())
  saleId      Int?      @unique @map("sale_id")
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  provider    String
  mpOrderId   String?   @unique @map("mp_order_id")
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  qrData      String?   @map("qr_data")
  status      String    @default("created")
  expiresAt   DateTime? @map("expires_at")
  /// Líneas del ticket ya validadas por el servidor (para crear la venta al aprobarse el pago)
  items       Json
  userId      Int?      @map("user_id")
  /// Comercio que cobra: su cuenta de Mercado Pago (token + caja) se usa para crear/consultar/cancelar
  merchantId  Int?      @map("merchant_id")
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("payment_orders")
}

/// Equipo Libretita (ESP32 + WiFi) enchufado a la salida RS-232 de una balanza comercial.
/// `key` es la "clave" impresa en la etiqueta (pública, identifica el equipo). `secretHash` es el SHA-256
/// del secreto grabado en el firmware (nunca se guarda en claro). `claimCodeHash` = SHA-256 del código de
/// activación impreso en la etiqueta, que pide la app para vincular el equipo a un comercio.
model Device {
  id              Int          @id @default(autoincrement())
  key             String       @unique
  secretHash      String       @map("secret_hash")
  claimCodeHash   String       @map("claim_code_hash")
  merchantId      Int?         @map("merchant_id")
  merchant        Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  label           String?
  claimedAt       DateTime?    @map("claimed_at")
  firmware        String?
  scaleModel      String?      @map("scale_model")
  lastSeenAt      DateTime?    @map("last_seen_at")
  lastHeartbeatAt DateTime?    @map("last_heartbeat_at")
  lastRssi        Int?         @map("last_rssi")
  lastIp          String?      @map("last_ip")
  pendingCount    Int?         @map("pending_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  sales           DeviceSale[]

  @@map("devices")
}

/// Venta recibida de un equipo (POST /api/devices/sales), tal cual llegó. Idempotente por (equipo, `eventId`).
/// Si se pudo decodificar (total > 0) y el equipo tiene comercio, se crea además la `Sale` (`saleId`),
/// así aparece en Ventas y en los Reportes. `merchantId` = comercio del equipo al momento de recibirla
/// (null si todavía no estaba vinculado: se asigna al vincularlo).
model DeviceSale {
  id           Int       @id @default(autoincrement())
  eventId      String    @map("event_id")
  deviceId     Int       @map("device_id")
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  merchantId   Int?      @map("merchant_id")
  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  saleId       Int?      @unique @map("sale_id")
  sale         Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receivedAt   DateTime  @default(now()) @map("received_at")
  /// Hora de la venta usada en los reportes: la del equipo si es confiable, si no la de recepción
  soldAt       DateTime  @map("sold_at")
  deviceTime   DateTime? @map("device_time")
  scaleDate    String?   @map("scale_date")
  ticketNumber String?   @map("ticket_number")
  itemCount    Int?      @map("item_count")
  total        Decimal?  @db.Decimal(12, 2)
  /// true si la venta se pudo decodificar (hay total)
  decoded      Boolean   @default(false)
  rawTicket    String    @map("raw_ticket")
  payload      Json

  @@unique([deviceId, eventId])
  @@index([deviceId, receivedAt])
  @@index([merchantId, soldAt])
  @@map("device_sales")
}
